{
  "name": "mt-dsl",
  "publisher": "dorian",
  "displayName": "mt-dsl",
  "version": "1.0.0",
  "description": "Metamorphic Testing DSL",
  "type": "module",
  "engines": {
    "vscode": "^1.67.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mt-dsl",
        "aliases": [
          "MT DSL",
          "mt-dsl"
        ],
        "extensions": [
          ".mt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mt-dsl",
        "scopeName": "source.mt-dsl",
        "path": "./syntaxes/mt-dsl.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:mt-dsl"
  ],
  "main": "./out/extension/main.cjs",
  "scripts": {
    "langium:generate": "langium generate",
    "build": "tsc && node esbuild.mjs",
    "build:extension": "node esbuild.mjs",
    "watch": "concurrently -n tsc,esbuild -c blue,yellow \"tsc -w\" \"node esbuild.mjs --watch\"",
    "generate": "node out/cli/main.js generate",
    "vscode:prepublish": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "langium": "^4.2.4",
    "vscode-languageclient": "~9.0.1",
    "vscode-languageserver": "~9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "~1.67.0",
    "concurrently": "~8.2.1",
    "esbuild": "~0.25.5",
    "langium-cli": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
