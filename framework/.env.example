# ============================================================
# Digital Twin Metamorphic Testing Framework - Environment
# ============================================================

# Target Eclipse Ditto Nginx IP:
# - Living Lab (remote): uibk_ip
# - Localhost (same machine as Docker): 127.0.0.1 (automatically bridged to host)
DITTO_NGINX_IP=uibk_ip

# Eclipse Ditto tenant ID
UT_TENANT=at.uibk.ut.tenants

# Basic Auth credentials
DITTO_USER=ditto
DITTO_PW=ditto
